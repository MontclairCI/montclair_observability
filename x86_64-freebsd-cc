#!/usr/bin/env bash
# Loop through all arguments passed by cc-rs and fix the target triple for Zig
args=()
for arg in "$@"; do
    if [ "$arg" = "--target=x86_64-unknown-freebsd" ]; then
        args+=("--target=x86_64-freebsd")
    else
        args+=("$arg")
    fi
done

# Execute zig cc with the corrected arguments
exec zig cc "${args[@]}"
